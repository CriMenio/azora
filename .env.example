# Copy to .env for local dev, or set these in Netlify → Site settings → Environment variables

# Google Apps Script Web App URL (Deploy → Web app → copy URL ending in /exec)
VITE_SPREADSHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Admin panel PIN (used at /#admin)
VITE_ADMIN_PIN="change-this-pin"
